<%= render partial: 'project_workflows/matrix_header' %>

<% if @statuses.any? %>
  <% if @editable %>
    <%= form_tag project_workflow_permissions_path(@project), method: :patch, id: 'workflow_form' do %>
      <%= hidden_field_tag 'tracker_id', @tracker.id, id: nil %>
      <%= hidden_field_tag 'role_id', @role.id, id: nil %>
      <%= hidden_field_tag 'used_statuses_only', params[:used_statuses_only], id: nil %>
      <div class="autoscroll">
        <%= render partial: 'project_workflows/permissions_grid', locals: { editable: true } %>
      </div>
      <%= submit_tag l(:button_save) %>
    <% end %>

    <%= javascript_tag do %>
    $("a.repeat-value").click(function(e){
      e.preventDefault();
      var td = $(this).closest('td');
      var selected = td.find("select").find(":selected").val();
      td.nextAll('td').find("select").val(selected);
    });
    <% end %>
  <% else %>
    <p class="project-workflow-readonly">
      <em>
        <%= @own_workflow ? l(:text_project_workflow_readonly_own) : l(:text_project_workflow_readonly_generic) %>
      </em>
    </p>
    <div class="autoscroll">
      <%= render partial: 'project_workflows/permissions_grid', locals: { editable: false } %>
    </div>
  <% end %>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
