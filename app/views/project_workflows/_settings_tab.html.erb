<%#
  Project settings -> Workflow.

  One line per tracker and role that this project can decide for -- the trackers
  it has enabled and the roles somebody holds in it -- with the state in words,
  the number of rules the project holds itself, and the actions that would
  change something. Every number links into the matrix it describes.

  Rendered from ProjectsController#settings, which loads the rows; this file
  queries nothing.
%>
<% if @project_workflow_rows.nil? %>
<% elsif @project_workflow_rows.empty? %>
  <p class="nodata"><%= l(:text_project_workflow_tab_nothing_to_configure) %></p>
<% else %>
  <p><%= l(:text_project_workflow_tab_description) %></p>
  <% back_url = settings_project_path(@project, tab: 'project_workflows') %>
  <% manage = User.current.allowed_to?(:manage_project_workflow, @project) %>
  <div class="autoscroll">
  <table class="list project-workflow-settings">
    <thead>
      <tr>
        <th><%= l(:label_tracker) %></th>
        <th><%= l(:label_role) %></th>
        <% @project_workflow_rule_types.each do |rule_type| %>
          <th><%= project_workflow_rule_type_label(rule_type) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @project_workflow_rows.each do |row| %>
      <tr>
        <td class="name"><%= row.tracker.name %></td>
        <td class="name"><%= row.role.name %></td>
        <% @project_workflow_rule_types.each do |rule_type| %>
          <% cell = row.cells[rule_type] %>
          <td class="project-workflow-<%= rule_type %>">
            <%= project_workflow_own_count_link(cell, row, rule_type) %>
            <%= project_workflow_state_tag(cell.state) %>
            <% if manage %>
              <%= render partial: 'project_workflows/scope_actions',
                         locals: { project: @project, tracker: row.tracker, role: row.role,
                                   rule_type: rule_type, state: cell.state, back_url: back_url } %>
            <% end %>
          </td>
        <% end %>
      </tr>
      <% end %>
    </tbody>
  </table>
  </div>
  <p class="project-workflow-scope-help"><em><%= l(:text_project_workflow_scope_help) %></em></p>
<% end %>
