<%#
  Project settings -> Workflow.

  One line per tracker and role this project has a say in -- the trackers it has
  enabled times the roles somebody holds in it, plus any role that already has a
  scope here however it got one -- with the state in words, the number of rules
  the project holds itself, and the actions that would change something. Every
  number links into the matrix it describes.

  A row that is only here because a scope exists is not offered a workflow of its
  own; it is here so that the one that exists can be seen and given back
  (finding F05).

  The rows come from project_workflow_settings_rows, which is a fixed number of
  collection queries for the whole tab and never one per row (G6). It is a helper rather
  than an instance variable set in ProjectsController on purpose: the plugin
  holds nothing inside that controller -- see
  RedmineProjectWorkflows::Patches::ProjectsHelperPatch#apply!.

  The tab is only in the list for somebody allowed to open it, so there is no
  permission check here; the actions below are gated separately, and every
  controller they post to checks again (INV-7).
%>
<%= project_workflow_compatibility_banner %>
<% rows = project_workflow_settings_rows(@project) %>
<% rule_types = ProjectWorkflowScope::RULE_TYPES %>
<% if rows.empty? %>
  <p class="nodata"><%= l(:text_project_workflow_tab_nothing_to_configure) %></p>
<% else %>
  <p><%= l(:text_project_workflow_tab_description) %></p>
  <% back_url = settings_project_path(@project, tab: 'project_workflows') %>
  <% manage = User.current.allowed_to?(:manage_project_workflow_rules, @project) %>
  <div class="autoscroll">
  <table class="list project-workflow-settings">
    <thead>
      <tr>
        <th><%= l(:label_tracker) %></th>
        <th><%= l(:label_role) %></th>
        <% rule_types.each do |rule_type| %>
          <th><%= project_workflow_rule_type_label(rule_type) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
      <tr>
        <td class="name"><%= row.tracker.name %></td>
        <td class="name"><%= row.role.name %></td>
        <% rule_types.each do |rule_type| %>
          <% cell = row.cells[rule_type] %>
          <td class="project-workflow-<%= rule_type %>">
            <%= project_workflow_own_count_link(cell, row, rule_type) %>
            <%= project_workflow_state_tag(cell.state) %>
            <%# Blocks, so the audit line and the links drop below the count and
                the state label rather than crowding onto one line -- and the
                links separated from each other and from the audit sentence, for
                the reason project_workflow_cell_details argues.

                The drawing is offered in the transitions column only: it draws
                transitions, and a link to it from the field-permissions cell
                would promise a picture of something that is not a graph. %>
            <%= project_workflow_cell_details(
                  cell,
                  [project_workflow_compare_link(@project, row.tracker, row.role, rule_type, cell.state),
                   (if rule_type == ProjectWorkflowScope::TRANSITIONS
                      project_workflow_graph_link(@project, row.tracker, row.role)
                    end)]
                ) %>
            <%# A block of its own, so the actions sit under the state label
                rather than beside it. This used to happen by accident: the
                details above were an empty <div> on a cell with no audit line
                and no links, and the empty element was doing the line break. It
                stopped being rendered when the details grew a condition, and the
                actions moved up onto the state line -- a regression that no spec
                could see and a browser could (finding F01 of
                2026-08-29-claude-browser, in the fix for it). The plugin ships
                no stylesheet, so the markup has to say this out loud. %>
            <% if manage %>
              <div class="project-workflow-cell-actions">
                <%= render partial: 'project_workflows/scope_actions',
                           locals: { project: @project, tracker: row.tracker, role: row.role,
                                     rule_type: rule_type, state: cell.state, back_url: back_url,
                                     offered: project_workflow_role_offered?(@project, row.role) } %>
              </div>
            <% end %>
          </td>
        <% end %>
      </tr>
      <% end %>
    </tbody>
  </table>
  </div>
  <p class="project-workflow-scope-help"><em><%= l(:text_project_workflow_scope_help) %></em></p>
<% end %>
